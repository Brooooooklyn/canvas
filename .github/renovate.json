{
  "extends": ["config:base", ":preserveSemverRanges"],
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "groupName": "rust toolchain",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["rustc"]
    },
    {
      "groupName": "cssparser",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["cssparser", "cssparser-color"]
    },
    {
      "groupName": "oxc-node",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@oxc-node/*"]
    },
    {
      "groupName": "Cargo lock file maintenance",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["lockFileMaintenance"]
    },
    {
      "description": "Skia's Fontations scaler pins these to Skia's versions (the crate.spec blocks in skia/MODULE.bazel); update them with Skia, not alone.",
      "matchManagers": ["cargo"],
      "matchFileNames": ["crates/skia-fontations/Cargo.toml"],
      "enabled": false
    },
    {
      "description": "cxx-build must equal cxx in crates/skia-fontations/Cargo.toml, which the rule above freezes; update both with Skia.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["cxx-build"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:monthly"]
  }
}
