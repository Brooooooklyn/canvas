{
  "extends": ["config:base", ":preserveSemverRanges"],
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "groupName": "rust toolchain",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["rustc"]
    },
    {
      "groupName": "cssparser",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["cssparser", "cssparser-color"]
    },
    {
      "groupName": "Cargo lock file maintenance",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["lockFileMaintenance"]
    },
    {
      "description": "Skia's Fontations scaler pins these to Skia's versions (skia/bazel/external/fontations/Cargo.toml); update them with Skia, not alone.",
      "matchManagers": ["cargo"],
      "matchFileNames": ["crates/skia-fontations/Cargo.toml"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:monthly"]
  }
}
